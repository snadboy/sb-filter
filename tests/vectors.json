 "cases": [
  {
   "name": "empty config matches nothing",
   "config": {},
   "expect_ids": [],
   "configured": false
  },
  {
   "name": "blank patterns only = unconfigured",
   "config": {
    "patterns": [
     "",
     "  "
    ]
   },
   "expect_ids": [],
   "configured": false
  },
  {
   "name": "pattern: implied wildcards on id",
   "config": {
    "patterns": [
     "fp300_occupancy"
    ]
   },
   "expect_ids": [
    "binary_sensor.bath_fp300_occupancy",
    "binary_sensor.kitchen_fp300_occupancy"
   ],
   "pattern_counts": [
    2
   ]
  },
  {
   "name": "pattern: tokens AND (id + name)",
   "config": {
    "patterns": [
     "fp300 kitchen"
    ]
   },
   "expect_ids": [
    "binary_sensor.kitchen_fp300_occupancy",
    "sensor.kitchen_fp300_battery"
   ]
  },
  {
   "name": "pattern: friendly name, case-insensitive",
   "config": {
    "patterns": [
     "office lamp"
    ]
   },
   "expect_ids": [
    "light.office"
   ]
  },
  {
   "name": "pattern: glob * and ?",
   "config": {
    "patterns": [
     "light.h?ll",
     "sensor.*_temperature"
    ]
   },
   "expect_ids": [
    "light.hall",
    "sensor.kitchen_temperature",
    "sensor.rack_temperature"
   ],
   "pattern_counts": [
    1,
    2
   ]
  },
  {
